{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,not-found,loading,error,route}.{ts,tsx}",
    "src/app/api/**/route.ts",
    "src/components/ui/index.ts",
    "src/data/index.ts",
    "src/config/site.ts",
    "src/locales/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@secretlint/quick-start",
    "eslint-config-next"
  ]
}
